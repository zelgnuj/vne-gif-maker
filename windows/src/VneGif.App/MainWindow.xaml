<Window x:Class="VneGif.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VnExpress GIF Maker" Width="1360" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="12.5" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/AppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel x:Name="ToolbarDock" Margin="14,0" LastChildFill="False"/>
        </Border>
        <Grid x:Name="Body" Grid.Row="1">
            <Grid x:Name="EmptyView"/>
            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="LeftPane" Margin="12,12,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                </Grid>
                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border x:Name="TabHost" DockPanel.Dock="Top" Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
                        <Border x:Name="ExportPanelHost" DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                                Padding="12" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InspectorStack"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Border x:Name="DropOverlay" BorderBrush="{StaticResource BrandBright}" BorderThickness="3" CornerRadius="12"
                    Margin="6" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="PreparingToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Background="#F02C2C30" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
                    Padding="16,7" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="PreparingText"/>
            </Border>
        </Grid>
    </Grid>
</Window>
